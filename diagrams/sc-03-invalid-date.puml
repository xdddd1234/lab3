
@startuml
title SC-03 — Неправильна дата повернення

autonumber

actor "Бібліотекар" as Librarian
boundary "LibraryUI" as UI
control "LoanService" as Service
control "Clock" as Clock
entity "ReaderRepository" as Readers
entity "BookRepository" as Books
entity "LoanRepository" as Loans

note over Librarian, UI
  Передумова SC-03:
  бібліотекар авторизований
  і має право видавати книги.
end note

Librarian -> UI: submitLoan(15, 101, "20.10.2026")
activate UI

UI -> Service: issueBook(15, 101, "20.10.2026")
activate Service

Service -> Readers: findReaderById(15)
activate Readers
Readers --> Service: Reader(id=15)
deactivate Readers

alt Читач зареєстрований
    Service -> Books: findBookById(101)
    activate Books
    Books --> Service: Book(id=101)
    deactivate Books

    Service -> Loans: findActiveLoan(101)
    activate Loans
    Loans --> Service: null
    deactivate Loans

    alt Книга доступна
        Service -> Clock: today()
        activate Clock
        Clock --> Service: 21.10.2026
        deactivate Clock

        Service -> Service: validateDueDate("20.10.2026", "21.10.2026")

        alt dueDate раніше loanDate
            Service --> UI: ValidationError("Неправильна дата повернення")
            UI -> UI: showError("Неправильна дата повернення")
            UI --> Librarian: Видачу відхилено

        else Дата правильна
            Service --> UI: DateValidationPassed()
            UI -> UI: showStatus("Дата правильна")
            UI --> Librarian: Можна продовжити оформлення
        end

    else Книга вже видана
        Service --> UI: LoanError("Книга вже видана")
        UI -> UI: showError("Книга вже видана")
        UI --> Librarian: Видачу відхилено
    end

else Читача не знайдено
    Service --> UI: LoanError("Читача не знайдено")
    UI -> UI: showError("Читача не знайдено")
    UI --> Librarian: Видачу відхилено
end

deactivate Service
deactivate UI

note over Service, Loans
  У сценарії SC-03:
  dueDate = 20.10.2026
  loanDate = 21.10.2026

  Дата повернення неправильна.
  Новий Loan не створюється.
end note

@enduml
